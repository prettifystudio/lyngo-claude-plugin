#!/usr/bin/env node
// lyngo: the Lyngo CLI for coding agents and people. Zero dependencies, Node 20+.
// Reads the changed files and the catalogs from disk, asks the Lyngo server,
// applies the patch, prints a short report. A model never holds the files.
//
//   lyngo login                                   sign in once; the token goes to ~/.config/lyngo/token
//   lyngo logout                                  revoke the token and delete the file
//   lyngo whoami                                  who the token belongs to
//   lyngo init [--languages fr,de] [--primary en] [--workspace <name>] [--yes] [--github] [--wait] [--no-wait] [--no-install]
//                                                 connect this repository: project, scaffolding, languages, agent hook
//   lyngo localize [--all] [--languages fr,de] [--no-translate] [--dry] [--hook]
//                                                 localize (+ translate) the working tree's changes
//   lyngo check <file>                            the user-facing strings of one file
//   lyngo status                                  the project as Lyngo knows it
//
// Config: LYNGO_HOST (default https://lyngo.app), LYNGO_URL (MCP endpoint,
// default $LYNGO_HOST/mcp/admin), LYNGO_TOKEN (or ~/.config/lyngo/token),
// LYNGO_JOB_TIMEOUT (seconds to wait for one localize or translate job, default 3900).
'use strict';
const crypto = require('crypto');
const fs = require('fs');
const os = require('os');
const path = require('path');
const { execFileSync, spawn } = require('child_process');

const HOST = (process.env.LYNGO_HOST || 'https://lyngo.app').replace(/\/+$/, '');
const MCP_URL = process.env.LYNGO_URL || HOST + '/mcp/admin';
const AGENT_MCP_URL = HOST + '/mcp';
const TOKEN_DIR = path.join(os.homedir(), '.config', 'lyngo');
const TOKEN_FILE = path.join(TOKEN_DIR, 'token');
// Milliseconds per protocol second. Tests shrink it; people never set it.
const TICK = Number(process.env.LYNGO_TICK_MS) > 0 ? Number(process.env.LYNGO_TICK_MS) : 1000;
// The Stop hook says so when the CLI is not on PATH, instead of a "command not
// found" that scrolls past unread (corp1 setup, 2026-10-18). No pipe: Claude
// Code's JSON must reach lyngo on stdin, and stdout must stay one JSON object.
const HOOK_COMMAND = `if command -v lyngo >/dev/null 2>&1; then lyngo localize --hook; else echo '{"systemMessage":"Lyngo: the CLI is not on PATH. Install it: npm i -g @prettifystudio/lyngo-cli"}'; fi`;
const OLD_HOOK_COMMANDS = [
  'lyngo localize 2>&1 | tail -20',
  'if command -v lyngo >/dev/null 2>&1; then lyngo localize 2>&1 | tail -20; else echo "lyngo: the CLI is not on PATH. Install it: npm i -g @prettifystudio/lyngo-cli"; fi',
];
const SRC = /\.(blade\.php|php|tsx|jsx|ts|js|vue|svelte)$/;
const SKIP = /(^|\/)(vendor|node_modules|tests?|database|storage|bootstrap|public|config|\.git)\//;

class CliError extends Error {}
class CliTooOld extends CliError {} // the server refused this version (HTTP 426)

function fail(msg) { throw new CliError(msg); }
const sleep = (seconds) => new Promise((resolve) => setTimeout(resolve, seconds * TICK));

// ── git ────────────────────────────────────────────────────────────────────

function git(args) { return execFileSync('git', args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }); }
function gitTry(args) { try { return git(args); } catch { return null; } }
function root() {
  const top = gitTry(['rev-parse', '--show-toplevel']);
  if (top === null) fail('not a git repository. Run lyngo inside your project.');
  return top.trim();
}
let remoteCache;
function repoRemote() {
  if (remoteCache === undefined) {
    const inside = gitTry(['rev-parse', '--is-inside-work-tree']);
    remoteCache = inside && inside.trim() === 'true' ? (gitTry(['remote', 'get-url', 'origin']) || '').trim() || null : null;
  }
  return remoteCache;
}

// ── token ──────────────────────────────────────────────────────────────────

function readToken(required = true) {
  if (process.env.LYNGO_TOKEN && process.env.LYNGO_TOKEN.trim()) return process.env.LYNGO_TOKEN.trim();
  if (fs.existsSync(TOKEN_FILE)) {
    const t = fs.readFileSync(TOKEN_FILE, 'utf8').trim();
    if (t) return t;
  }
  if (required) fail('not logged in. Run lyngo login first.');
  return null;
}
const prefixOf = (t) => (t || '').slice(0, 8) + '…';
function saveToken(t) {
  fs.mkdirSync(TOKEN_DIR, { recursive: true, mode: 0o700 });
  fs.chmodSync(TOKEN_DIR, 0o700);
  fs.writeFileSync(TOKEN_FILE, t + '\n', { mode: 0o600 });
  fs.chmodSync(TOKEN_FILE, 0o600);
}
// Never let a token reach the terminal: replace it with its prefix.
function scrub(text, t) { return t ? String(text).split(t).join(prefixOf(t)) : String(text); }

// ── version and the update notice ──────────────────────────────────────────
// Every request names this version in User-Agent. The server answers with the
// newest CLI (X-Lyngo-Cli-Latest) and the oldest one it accepts
// (X-Lyngo-Cli-Minimum), and refuses a CLI below that one with HTTP 426.
// X-Lyngo-Server names the server build (its short commit) that answered, so
// a bug report can say which server decided a result.

function version() {
  try { return JSON.parse(fs.readFileSync(path.join(__dirname, '..', 'package.json'), 'utf8')).version || '0.1.0'; } catch { return '0.1.0'; }
}
const VERSION = version();
const USER_AGENT = `lyngo-cli/${VERSION} (node ${process.version}; ${process.platform})`;
const UPDATE_COMMAND = 'npm i -g @prettifystudio/lyngo-cli';
const NOTICE_FILE = path.join(TOKEN_DIR, 'update-notice.json');
const DAY_MS = 24 * 60 * 60 * 1000;
let latestSeen = null; // X-Lyngo-Cli-Latest of the last answer
let refused = false; // a 426 already says to update
let serverSeen = null; // X-Lyngo-Server of the last answer: the server's short commit

// Numbers, not strings: 0.2.10 is newer than 0.2.9. A pre-release tag is ignored.
function compareVersions(a, b) {
  const parts = (v) => { const m = /^(\d+)\.(\d+)\.(\d+)/.exec(String(v).trim()); return m ? m.slice(1).map(Number) : null; };
  const x = parts(a), y = parts(b);
  if (!x || !y) return 0;
  for (let i = 0; i < 3; i++) if (x[i] !== y[i]) return x[i] < y[i] ? -1 : 1;
  return 0;
}

// The update line, at most once a day per machine and per latest version
// (~/.config/lyngo/update-notice.json); null when none is due.
function updateNotice() {
  if (refused || !latestSeen || compareVersions(VERSION, latestSeen) >= 0) return null;
  let last = {};
  try { last = JSON.parse(fs.readFileSync(NOTICE_FILE, 'utf8')) || {}; } catch { /* never shown on this machine */ }
  if (last.latest === latestSeen && Date.now() - Date.parse(last.shown_at) < DAY_MS) return null;
  try {
    fs.mkdirSync(TOKEN_DIR, { recursive: true, mode: 0o700 });
    fs.writeFileSync(NOTICE_FILE, JSON.stringify({ latest: latestSeen, shown_at: new Date().toISOString() }) + '\n', { mode: 0o600 });
  } catch { /* shown again next time: better than never */ }
  return `Lyngo CLI ${latestSeen} is available (you have ${VERSION}): ${UPDATE_COMMAND}`;
}

// ── HTTP ───────────────────────────────────────────────────────────────────

// One dropped connection must not end a long run: localize --all on 1554 files
// died at call 34 of 52 on an ECONNRESET that never reached the server
// (2026-11-06). A network error or a proxy error before the origin answered is
// tried again after 2, 5 and 10 s. Every other status keeps its own handling.
const RETRY_WAITS = [2, 5, 10];
const RETRY_CODES = new Set(['ECONNRESET', 'ECONNREFUSED', 'ETIMEDOUT', 'EPIPE', 'EAI_AGAIN', 'ENOTFOUND', 'UND_ERR_SOCKET', 'UND_ERR_CONNECT_TIMEOUT', 'UND_ERR_HEADERS_TIMEOUT']);
const RETRY_STATUSES = new Set([502, 503, 504, 520, 521, 522, 523, 524]);
let quiet = false; // the Stop hook prints one JSON object and nothing else (localizeHook)

async function request(method, url, { body, auth = true, accept = 'application/json' } = {}) {
  const headers = { Accept: accept, 'User-Agent': USER_AGENT };
  if (body !== undefined) headers['Content-Type'] = 'application/json';
  if (auth) headers.Authorization = 'Bearer ' + readToken();
  const remote = repoRemote();
  if (remote) headers['X-Lyngo-Remote'] = remote;
  const payload = body === undefined ? undefined : JSON.stringify(body);
  let res, text;
  for (let attempt = 1; ; attempt++) {
    let problem;
    try {
      res = await fetch(url, { method, headers, body: payload });
      text = await res.text();
      if (!RETRY_STATUSES.has(res.status)) break;
      problem = 'HTTP ' + res.status;
    } catch (e) {
      const code = e.cause?.code;
      const network = RETRY_CODES.has(code) || (!code && e.message === 'fetch failed');
      if (!network || attempt > RETRY_WAITS.length) fail(`could not reach ${HOST} (${code || e.message}).`);
      problem = code || e.message;
    }
    if (attempt > RETRY_WAITS.length) break;
    const wait = RETRY_WAITS[attempt - 1];
    if (!quiet) console.error(`lyngo: connection problem (${problem}), trying again in ${wait} s (${attempt}/${RETRY_WAITS.length + 1}).`);
    await sleep(wait);
  }
  let data = {};
  if (text) {
    try { data = JSON.parse(text); } catch {
      // A streamed MCP answer: the last data line holds the JSON.
      const line = text.split('\n').filter((l) => l.startsWith('data:')).pop();
      try { data = line ? JSON.parse(line.slice(5)) : { message: text.slice(0, 200) }; } catch { data = { message: text.slice(0, 200) }; }
    }
  }
  const latest = res.headers.get('x-lyngo-cli-latest');
  if (latest) latestSeen = latest.trim();
  const build = (res.headers.get('x-lyngo-server') || '').trim();
  if (/^[0-9a-f]{7,40}$/i.test(build)) serverSeen = build;
  if (res.status === 426) {
    refused = true;
    const minimum = res.headers.get('x-lyngo-cli-minimum');
    throw new CliTooOld(data.message || `this lyngo CLI (${VERSION}) is too old${minimum ? `; Lyngo needs ${minimum} or newer` : ''}. Update it: ${UPDATE_COMMAND}`);
  }
  if (auth && res.status === 401) fail('the token was refused (revoked or expired). Run lyngo login.');
  if (res.status === 429) fail('too many calls. Wait a minute and try again.');
  return { status: res.status, data };
}
const api = (method, p, opts) => request(method, HOST + p, opts);
const messageOf = (data, status) => data.message || (typeof data.error === 'string' ? data.error : null) || `the server answered ${status}.`;
function expect(r, ...ok) { if (!ok.includes(r.status)) fail(messageOf(r.data, r.status)); return r.data; }

async function call(name, args) {
  const r = await request('POST', MCP_URL, {
    accept: 'application/json, text/event-stream',
    body: { jsonrpc: '2.0', id: 1, method: 'tools/call', params: { name, arguments: args } },
  });
  if (r.status !== 200) fail(messageOf(r.data, r.status));
  const body = r.data;
  if (body.error) fail(body.error.message || JSON.stringify(body.error));
  const text = body.result?.content?.[0]?.text ?? '';
  if (body.result?.isError) fail(text);
  try { return JSON.parse(text); } catch { fail('unexpected answer: ' + text.slice(0, 200)); }
}

// localize and translate run as a job on the server (async: true): the call
// answers at once with its id, and job_status hands back the payload the call
// used to return. A proxy cut the long calls at 100 s (HTTP 524, 2026-10-31).
// A server without jobs answers with the payload itself.
const POLL_SECONDS = 2.5;
const JOB_TIMEOUT_SECONDS = Number(process.env.LYNGO_JOB_TIMEOUT) > 0 ? Number(process.env.LYNGO_JOB_TIMEOUT) : 65 * 60;
async function callJob(name, args, progress) {
  const first = await call(name, { ...args, async: true });
  if (!first || typeof first.job !== 'string') return first;
  let waited = 0;
  let told = 0;
  for (;;) {
    await sleep(POLL_SECONDS);
    waited += POLL_SECONDS;
    const s = await call('job_status', { job: first.job });
    if (s.status === 'done') return s.result || {};
    if (s.status === 'failed') fail(s.error || `the job ${first.job} failed on the server.`);
    if (waited >= JOB_TIMEOUT_SECONDS) fail(`the server did not finish within ${Math.round(JOB_TIMEOUT_SECONDS / 60)} minutes (job ${first.job}). Run the command again later.`);
    if (progress && waited - told >= 15) { told = waited; progress(`  ... Lyngo is still working (${s.status}, ${Math.round(waited)} s)`); }
  }
}

// ── terminal helpers ───────────────────────────────────────────────────────

function openUrl(url) {
  if (process.env.LYNGO_NO_BROWSER) return;
  // The tests name a stand-in opener and wait for it to end; people never set it.
  if (process.env.LYNGO_OPENER) { try { execFileSync(process.env.LYNGO_OPENER, [url], { stdio: 'ignore' }); } catch { /* the URL is printed */ } return; }
  const [cmd, args] = process.platform === 'darwin' ? ['open', [url]]
    : process.platform === 'win32' ? ['cmd', ['/c', 'start', '""', url]]
    : ['xdg-open', [url]];
  try {
    const child = spawn(cmd, args, { stdio: 'ignore', detached: true });
    child.on('error', () => {});
    child.unref();
  } catch { /* the URL is printed; opening it is a convenience */ }
}

async function ask(question) {
  if (!process.stdin.isTTY) return null;
  const rl = require('readline').createInterface({ input: process.stdin, output: process.stdout });
  return new Promise((resolve) => rl.question(question, (answer) => { rl.close(); resolve(answer.trim()); }));
}
async function confirm(question, opts) {
  if (opts.yes) return true;
  const answer = await ask(question + ' [Y/n] ');
  return answer === null ? false : answer === '' || /^y(es)?$/i.test(answer);
}

function findOnPath(name) {
  const exts = process.platform === 'win32' ? ['.cmd', '.exe', ''] : [''];
  for (const dir of (process.env.PATH || '').split(path.delimiter)) {
    for (const ext of exts) {
      const p = path.join(dir, name + ext);
      try { fs.accessSync(p, fs.constants.X_OK); if (fs.statSync(p).isFile()) return p; } catch { /* next */ }
    }
  }
  return null;
}

// ── login, logout, whoami ──────────────────────────────────────────────────

async function login() {
  const d = expect(await api('POST', '/cli/device', { auth: false, body: { hostname: os.hostname() } }), 200);
  if (!d || !d.user_code || !d.device_code) fail('the server did not answer with a login code. Check LYNGO_HOST.');
  console.log(`Open ${d.verification_url} and enter ${d.user_code}`);
  openUrl(d.verification_url_complete || d.verification_url);
  let interval = Number(d.interval) > 0 ? Number(d.interval) : 5;
  const deadline = Date.now() + (Number(d.expires_in) > 0 ? Number(d.expires_in) : 900) * TICK;
  while (Date.now() < deadline) {
    await sleep(interval);
    const r = await api('POST', '/cli/token', { auth: false, body: { device_code: d.device_code } });
    if (r.status === 200 && r.data.token) {
      saveToken(r.data.token);
      console.log(`Logged in as ${r.data.user?.email || r.data.user?.name || 'you'}. Token ${r.data.prefix || prefixOf(r.data.token)} saved to ${TOKEN_FILE}.`);
      if (process.env.LYNGO_TOKEN) console.log('Note: LYNGO_TOKEN is set in your environment and takes precedence over the saved token.');
      return;
    }
    const error = r.data.error;
    if (error === 'authorization_pending') continue;
    if (error === 'slow_down') { interval += 5; continue; }
    if (error === 'access_denied') fail('the login was cancelled in the browser.');
    if (error === 'expired_token') fail('the code expired. Run lyngo login again.');
    fail(messageOf(r.data, r.status));
  }
  fail('the code expired. Run lyngo login again.');
}

async function logout() {
  const t = readToken(false);
  if (!t) { console.log('Not logged in.'); return; }
  let revoked = false;
  let tooOld = null;
  try {
    const r = await api('DELETE', '/cli/token');
    revoked = r.status === 204 || r.status === 200;
  } catch (e) { if (e instanceof CliTooOld) tooOld = e; /* the local file goes anyway */ }
  if (fs.existsSync(TOKEN_FILE)) fs.unlinkSync(TOKEN_FILE);
  if (tooOld) throw tooOld;
  console.log(revoked ? `Logged out. Token ${prefixOf(t)} is revoked.` : `Logged out on this machine. The server did not confirm that token ${prefixOf(t)} is revoked; revoke it in Settings, CLI.`);
  if (process.env.LYNGO_TOKEN) console.log('Note: LYNGO_TOKEN is still set in your environment.');
}

async function whoami() {
  const me = expect(await api('GET', '/cli/me'), 200);
  console.log(`${me.user?.name || ''} <${me.user?.email || ''}>`.trim());
  console.log(`token: ${me.token?.prefix || prefixOf(readToken())} (${me.token?.kind || 'unknown'})`);
  if (me.workspaces?.length) {
    console.log('workspaces:');
    for (const w of me.workspaces) console.log(`  ${w.current ? '*' : ' '} ${w.name} (${w.role})`);
  }
}

// ── init ───────────────────────────────────────────────────────────────────

function printProblem(r) {
  console.error('lyngo: ' + messageOf(r.data, r.status));
  if (r.data.billing_url) console.error('  ' + r.data.billing_url);
}

// A build server sets CI (any value but "false"): nobody there opens a link.
function inCI() { const v = (process.env.CI || '').trim(); return v !== '' && v.toLowerCase() !== 'false'; }
// Written with a callback, so the text has reached the OS before the wait
// starts: an agent that reads the output from a file sees the link at once.
const printNow = (text) => new Promise((resolve) => process.stdout.write(text + '\n', () => resolve()));

// The GitHub wait asks every 2 s, counted from the last answer: the server
// answers from the repository list (saved by the Setup URL redirect or the
// webhook) and asks GitHub itself at most every 4 s, so a grant shows within
// a poll or two, as fast as npm login notices a login (0.2.17; was 5 s).
const GITHUB_POLL_SECONDS = 2;

async function connectProject(opts, remote, branch) {
  const body = { remote, branch, workspace: opts.workspace };
  for (let attempt = 0; attempt < 3; attempt++) {
    const r = await api('POST', '/cli/projects', { body });
    const s = r.data.status;
    if ((r.status === 200 || r.status === 201) && r.data.project) return r.data;
    if (s === 'needs_github_app' || r.status === 409) {
      await printNow(messageOf(r.data, r.status) + (r.data.connect_url ? '\n  ' + r.data.connect_url : ''));
      if (!r.data.owner) { process.exitCode = 1; return null; }
      // CI or --no-wait: nobody acts on this run. Say what to do and stop;
      // the next run picks up where this one ended (corp2, 2026-10-24).
      if (opts['no-wait'] || (inCI() && !opts.wait && !opts.github)) {
        console.log('WAITING FOR THE PERSON: open the link above, add the repository to the Lyngo GitHub App, then run lyngo init again.');
        process.exitCode = 3;
        return null;
      }
      // Like npm login: open the link, wait, continue by itself, also for an
      // agent. Without a terminal the wait ends at 9 minutes, before Claude
      // Code's 10-minute command limit kills it (2026-11-07).
      const tty = !!process.stdin.isTTY;
      if (r.data.connect_url && (!tty || opts.github || await confirm('Open it now?', opts))) openUrl(r.data.connect_url);
      const minutes = tty ? 10 : 9;
      await printNow(`Waiting for GitHub (up to ${minutes} minutes)...`);
      const q = new URLSearchParams({ remote, ...(opts.workspace ? { workspace: opts.workspace } : {}) });
      const start = Date.now();
      let connected = false;
      let told = 0;
      while (!connected && Date.now() - start < minutes * 60 * TICK) {
        await sleep(GITHUB_POLL_SECONDS);
        const st = expect(await api('GET', '/cli/projects/status?' + q), 200);
        connected = !!st.github_connected;
        const m = Math.floor((Date.now() - start) / (60 * TICK));
        if (!connected && m > told && m < minutes) { told = m; await printNow(`Still waiting for GitHub (${m} of ${minutes} minutes)...`); }
      }
      if (!connected) fail(`GitHub is still not connected after ${minutes} minutes. Add the repository to the Lyngo GitHub App, then run lyngo init again.`);
      console.log('GitHub is connected.');
      continue;
    }
    printProblem(r);
    process.exitCode = 1;
    return null;
  }
  fail('GitHub reports the repository as connected, but Lyngo cannot see it yet. Run lyngo init again in a minute.');
}

function detectionWarning(branch) {
  const ahead = gitTry(['rev-list', '--count', '@{u}..HEAD']);
  const notPushed = ahead === null || Number(ahead.trim()) > 0;
  const pkgDirty = (gitTry(['status', '--porcelain', '--', 'package.json']) || '').trim() !== '';
  if (notPushed || pkgDirty) console.log(`Detection reads ${branch} on GitHub. Push first for an exact result.`);
}

async function chooseLanguages(project, opts) {
  const current = project.languages || [];
  let list = opts.languages;
  if (!list) {
    const answer = opts.yes ? null : await ask(`Languages [${current.join(',') || 'none'}]: `);
    list = answer ? answer.split(/[,\s]+/).map((s) => s.trim()).filter(Boolean) : current;
  }
  if (!list.length) fail('choose the languages with --languages fr,de.');
  // --languages names the TARGET languages; the source language stays the
  // project's primary, English when the project has none yet, or --primary.
  const primary = opts.primary || project.primary_language || 'en';
  if (!list.includes(primary)) list = [primary, ...list];
  const same = list.length === current.length && list.every((l) => current.includes(l)) && primary === project.primary_language;
  if (same) { console.log(`Languages: ${primary} -> ${list.filter((l) => l !== primary).join(', ') || 'none yet'}`); return project; }
  const r = await api('PATCH', `/cli/projects/${project.id}`, { body: { languages: list, primary_language: primary } });
  if (r.status !== 200) { printProblem(r); fail('the languages were not saved.'); }
  const updated = r.data.project || project;
  console.log(`Languages: ${updated.primary_language || primary} -> ${(updated.languages || list).filter((l) => l !== (updated.primary_language || primary)).join(', ')}`);
  return updated;
}

// File content goes to the server only as valid UTF-8. A Latin-1 file read as
// 'utf8' turns each accented byte into U+FFFD, the server's patch is built on
// that text, and git apply refuses it (lyngo-gaps cafe.blade.php, 2026-11-11).
// ignoreBOM keeps a BOM in the text, so the patch still matches the file.
const UTF8 = new TextDecoder('utf-8', { fatal: true, ignoreBOM: true });
function utf8(bytes) { try { return UTF8.decode(bytes); } catch { return null; } }
// The text of a regular file, or null (missing, not a file, not UTF-8). A file
// that is not UTF-8 is added to notUtf8 when the caller passes that Set.
function readIfFile(p, notUtf8) {
  let bytes;
  try { if (!fs.statSync(p).isFile()) return null; bytes = fs.readFileSync(p); } catch { return null; }
  const text = utf8(bytes);
  if (text === null && notUtf8) notUtf8.add(p);
  return text;
}
const notUtf8Line = (p) => `  left as written, not UTF-8: ${p}`;

// Windows-1252 text (Latin-1 is its subset) becomes UTF-8 on disk before it is
// sent, and is named: the server reads UTF-8 only (lyngo-gaps cafe.blade.php,
// 2026-11-11). Bytes that are not such text (Windows-1252's five unassigned
// positions, control bytes no text holds) stay as written, as before.
// 0x80-0x9F as Windows-1252 maps them; null where the code page has nothing.
const CP1252_HIGH = [0x20AC, null, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021, 0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, null, 0x017D, null,
  null, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014, 0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, null, 0x017E, 0x0178];
function fromWindows1252(bytes) {
  let out = '';
  for (const b of bytes) {
    if (b <= 0x08 || (b >= 0x0E && b <= 0x1A) || (b >= 0x1C && b <= 0x1F)) return null;
    if (b >= 0x80 && b <= 0x9F) {
      const cp = CP1252_HIGH[b - 0x80];
      if (cp === null) return null;
      out += String.fromCodePoint(cp);
    } else out += String.fromCharCode(b);
  }
  return declareUtf8(out);
}
// A converted file's own encoding declarations say UTF-8 too (<meta charset>, http-equiv, <?xml encoding>), as the server's Utf8Content does.
const LEGACY_CHARSET = '(?:iso-?8859-1|iso_8859-1|latin-?1|windows-1252|cp1252)';
function declareUtf8(text) {
  return text
    .replace(new RegExp(`(<meta\\b[^>]*?\\bcharset\\s*=\\s*["']?)${LEGACY_CHARSET}(?=["'\\s;>/])`, 'gi'), '$1UTF-8')
    .replace(new RegExp(`(<\\?xml\\b[^>]*?\\bencoding\\s*=\\s*["'])${LEGACY_CHARSET}(?=["'])`, 'gi'), '$1UTF-8');
}
// Converts the file on disk when it is Windows-1252 text that is not UTF-8; true when it did.
function convertToUtf8(p) {
  let bytes;
  try { if (!fs.statSync(p).isFile()) return false; bytes = fs.readFileSync(p); } catch { return false; }
  if (utf8(bytes) !== null) return false;
  const text = fromWindows1252(bytes);
  if (text === null) return false;
  fs.writeFileSync(p, text);
  return true;
}
const convertedLine = (p) => `  converted to UTF-8 (was Windows-1252): ${p}`;

// The submodules checked out in this working tree, by path from the top. Their
// files are localized like the app's own, into the app's catalogs; each one
// changed is named, to be committed in its own repository too (lyngo-gaps packages/ui).
function submodules() {
  return (gitTry(['submodule', 'status', '--recursive']) || '').split('\n').map((l) => l.match(/^[ +U][0-9a-f]+ (.+?)(?: \(.*\))?$/)).filter(Boolean).map((m) => m[1]);
}
const submoduleOf = (p, subs) => subs.filter((s) => p.startsWith(s + '/')).sort((a, b) => b.length - a.length)[0] || null;

// The package manager install after the setup patch: without it Vite cannot
// resolve the new imports and the page goes blank (vito, Inertia React). Run as a
// program and arguments, never a shell string, and only a known manager.
// Only these exact commands run; anything else from the server is printed, never executed.
const INSTALLERS = new Set(['npm install', 'pnpm install', 'yarn install', 'bun install']);
function install(command, opts) {
  const [program, ...args] = command.trim().split(/\s+/);
  if (opts['no-install'] || opts.hook || !INSTALLERS.has([program, ...args].join(' '))) { console.log(`Run ${command}`); return; }
  const bin = findOnPath(program);
  const hint = `Run ${command} in ${process.cwd()} before you start the dev server.`;
  if (!bin) { console.error(`lyngo: ${program} is not installed, so the new packages are not. ${hint}`); process.exitCode = 1; return; }
  console.log(`Running ${command}`);
  try {
    execFileSync(bin, args, { stdio: 'inherit' });
  } catch (e) {
    console.error(`lyngo: ${command} failed (${e.status != null ? 'exit ' + e.status : e.code || e.message}). ${hint}`);
    process.exitCode = 1;
    return;
  }
  console.log('Restart your dev server so Vite picks up the new packages.');
}

async function scaffold(project, opts = {}) {
  const tree = (gitTry(['ls-files', '-z', '--cached', '--others', '--exclude-standard']) || '').split('\0').filter(Boolean);
  const sent = new Map();
  for (const p of ['package.json', 'composer.json']) { const c = readIfFile(p); if (c !== null) sent.set(p, c); }
  for (let round = 0; round <= 3; round++) {
    const r = await api('POST', `/cli/projects/${project.id}/scaffold`, { body: { tree, files: [...sent].map(([p, content]) => ({ path: p, content })) } });
    if (r.status === 409 && Array.isArray(r.data.needs)) {
      let added = 0;
      for (const p of r.data.needs) {
        if (sent.has(p)) continue;
        const c = readIfFile(p);
        if (c !== null) { sent.set(p, c); added++; }
      }
      if (added === 0) fail('the server asked for files this working tree does not have: ' + r.data.needs.slice(0, 5).join(', '));
      continue;
    }
    const d = expect(r, 200);
    if (!d.patch || !d.patch.trim()) { console.log('Scaffolding: nothing to add.'); return; }
    const tmp = path.join(os.tmpdir(), `lyngo-scaffold-${Date.now()}.patch`);
    fs.writeFileSync(tmp, d.patch);
    try {
      git(['apply', '--whitespace=nowarn', tmp]);
    } catch (e) {
      console.error(`lyngo: the scaffolding patch did not apply (${(e.stderr || '').toString().trim()}). It is at ${tmp}`);
      process.exitCode = 1;
      return;
    }
    fs.unlinkSync(tmp);
    console.log('Scaffolding applied:');
    for (const f of d.files || []) console.log('  ' + f);
    for (const n of d.notes || []) console.log('  ' + n);
    if (d.install_command) install(d.install_command, opts);
    return;
  }
  fail('the server kept asking for more files. Run lyngo init again.');
}

function setUpClaudeCode(top, remote) {
  const claude = findOnPath('claude');
  if (!claude) { console.log('Claude Code not found: no agent setup. Run lyngo localize before you commit.'); return; }
  const t = readToken();
  const run = (args) => execFileSync(claude, args, { cwd: top, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] });
  try { run(['mcp', 'remove', 'lyngo', '-s', 'local']); } catch { /* not registered yet */ }
  try {
    run(['mcp', 'add', '--transport', 'http', '--scope', 'local', 'lyngo', AGENT_MCP_URL,
      '-H', 'Authorization: Bearer ' + t, '-H', 'X-Lyngo-Remote: ' + remote]);
  } catch (e) {
    console.error('lyngo: could not register the Lyngo MCP server in Claude Code (' + scrub(((e.stderr || e.message || '') + '').trim(), t) + ').');
    process.exitCode = 1;
  }

  // One Stop hook, in the settings file git does not track.
  const dir = path.join(top, '.claude');
  const file = path.join(dir, 'settings.local.json');
  let settings = {};
  if (fs.existsSync(file)) {
    try { settings = JSON.parse(fs.readFileSync(file, 'utf8') || '{}'); } catch {
      console.error('lyngo: .claude/settings.local.json is not valid JSON; the Stop hook was not added.');
      process.exitCode = 1;
      return;
    }
  }
  settings.hooks = settings.hooks || {};
  const stop = Array.isArray(settings.hooks.Stop) ? settings.hooks.Stop : [];
  const has = stop.some((group) => (group.hooks || []).some((h) => typeof h.command === 'string' && /\blyngo\b[^|]*\blocalize\b/.test(h.command)));
  let upgraded = false;
  for (const group of stop) for (const h of group.hooks || []) {
    if (OLD_HOOK_COMMANDS.includes(h.command)) { h.command = HOOK_COMMAND; upgraded = true; }
  }
  if (!has) {
    stop.push({ hooks: [{ type: 'command', command: HOOK_COMMAND }] });
    settings.hooks.Stop = stop;
  }
  if (!has || upgraded) {
    fs.mkdirSync(dir, { recursive: true });
    fs.writeFileSync(file, JSON.stringify(settings, null, 2) + '\n');
  }
  let ignored = true;
  try { execFileSync('git', ['check-ignore', '-q', '.claude/settings.local.json'], { cwd: top, stdio: 'ignore' }); } catch { ignored = false; }
  if (!ignored) {
    const rel = (gitTry(['rev-parse', '--git-path', 'info/exclude']) || '.git/info/exclude').trim();
    const exclude = path.isAbsolute(rel) ? rel : path.join(top, rel);
    const text = readIfFile(exclude) || '';
    if (!text.split('\n').includes('.claude/settings.local.json')) {
      fs.mkdirSync(path.dirname(exclude), { recursive: true });
      fs.writeFileSync(exclude, text + (text && !text.endsWith('\n') ? '\n' : '') + '.claude/settings.local.json\n');
    }
  }
  console.log(`Claude Code: the lyngo MCP server is registered for this repository, and the Stop hook ${has ? 'was already' : 'is'} in .claude/settings.local.json.`);
  // The slash commands (/lyngo:localize, /lyngo:init, /lyngo:status) come
  // from the plugin; say how to get it when it is not installed yet.
  let installed = false;
  try { installed = /\blyngo\b/.test(run(['plugin', 'list'])); } catch { /* no plugin support, or none installed */ }
  if (!installed) console.log('Slash commands for Claude Code (/lyngo:localize, /lyngo:init, /lyngo:status): claude plugin marketplace add prettifystudio/lyngo-claude-plugin && claude plugin install lyngo@lyngo');
}

async function init(opts) {
  const top = root();
  process.chdir(top);
  readToken();
  const remote = repoRemote();
  if (!remote) fail('this repository has no origin remote. Add the GitHub remote first.');
  const head = (gitTry(['rev-parse', '--abbrev-ref', 'HEAD']) || '').trim();
  const branch = head && head !== 'HEAD' ? head : undefined;

  const me = expect(await api('GET', '/cli/me'), 200);
  const ws = (me.workspaces || []).find((w) => opts.workspace ? (w.id === opts.workspace || w.name === opts.workspace) : w.current);
  if (ws) console.log(`Workspace: ${ws.name}`);

  const found = await connectProject(opts, remote, branch);
  if (!found) return;
  let project = found.project;
  const wsName = found.workspace?.name || ws?.name || '';
  console.log(found.status === 'created' ? `Created ${project.name} in workspace ${wsName}.` : `Set up on ${project.name} (workspace ${wsName}).`);

  detectionWarning(project.branch || branch || 'the default branch');
  const detected = expect(await api('POST', `/cli/projects/${project.id}/detect`, { body: {} }), 200);
  console.log(`Detected: ${detected.summary || 'no i18n setup found'}`);
  if (detected.i18n) project = { ...project, i18n: detected.i18n };

  // The agent setup comes before the language question: a run that stops
  // there still leaves the hook and the MCP server in place (corp1, 2026-10-18).
  setUpClaudeCode(top, remote);
  project = await chooseLanguages(project, opts);
  await scaffold(project, opts);
  await fillMissingCatalogs(project, opts);
  console.log('Done. Build as usual; lyngo localize runs when your agent finishes, or run it yourself before committing.');
}

// A language added today has no catalog in the repository yet; the first
// `lyngo localize` would create one with the keys of the changed files only
// (pingcrm, 2026-10-12: 11 of 103 keys). Say so, and fill it on request.
async function fillMissingCatalogs(project, opts) {
  const folder = catalogFolder(project);
  const primary = project.primary_language || 'en';
  const primaryPath = path.join(folder, primary + '.json');
  if (!readIfFile(primaryPath)) return;
  const targets = (project.languages || []).filter((l) => l !== primary);
  const missing = targets.filter((l) => !readIfFile(path.join(folder, l + '.json')));
  if (!missing.length) return;
  const keys = Object.keys(parseCatalog(primaryPath) || {}).length;
  console.log(`No catalog yet for ${missing.join(', ')}: ${folder}/<code>.json is missing, and ${primary}.json holds ${keys} keys that need translating.`);
  const go = opts.yes ? 'y' : await ask(`Translate ${missing.length === 1 ? 'it' : 'them'} now? [Y/n] `);
  if (go !== null && go !== '' && !/^y/i.test(go)) { console.log(`Later: lyngo translate ${missing.join(' ')}`); return; }
  if (go === null) { console.log(`Run: lyngo translate ${missing.join(' ')}`); return; }
  for (const code of missing) await translateLanguage(code, project);
}

function catalogFolder(project) { return ((project.i18n && project.i18n.catalog_folder) || 'lang').replace(/\/+$/, ''); }
function parseCatalog(p) { try { return JSON.parse(readIfFile(p) || ''); } catch { return null; } }

// The server's warnings: texts left as written, values a database may store,
// machine text kept in a catalog. Capped, so a long --all run stays readable.
const WARNINGS_SHOWN = 10;
function warningLines(warnings) {
  const list = [...warnings];
  if (!list.length) return [];
  const out = [`  warnings (${list.length}):`, ...list.slice(0, WARNINGS_SHOWN).map((w) => `    ${w}`)];
  if (list.length > WARNINGS_SHOWN) out.push(`    … and ${list.length - WARNINGS_SHOWN} more`);
  return out;
}

// The values the verifier flagged: one line each, where the code shows the key
// (file:line, when the server knows it) and why, in a few words. Capped too.
// An older server sends the keys alone.
const FLAGGED_SHOWN = 10;
function flaggedLines(flagged) {
  const list = [...flagged];
  const short = (k) => (k.length > 70 ? k.slice(0, 69) + '…' : k);
  const out = list.slice(0, FLAGGED_SHOWN).map((f) => {
    if (typeof f !== 'object' || f === null) return `    ${JSON.stringify(short(String(f)))}`;
    const place = f.file ? `${f.file}${f.line ? `:${f.line}` : ''} ` : '';
    return `    ${place}${JSON.stringify(short(String(f.key)))}${f.reason ? `: ${f.reason}` : ''}`;
  });
  if (list.length > FLAGGED_SHOWN) out.push(`    … and ${list.length - FLAGGED_SHOWN} more`);
  return out;
}

// ── translate: fill a language's catalog from the primary one ─────────────
async function translate(opts) {
  const top = root();
  process.chdir(top);
  readToken();
  const codes = opts._;
  if (!codes.length) fail('usage: lyngo translate <code> [<code>...]  (fills every key the language lacks)');
  const st = await call('status', {});
  const project = { primary_language: st.primary_language, languages: [st.primary_language, ...(st.languages || [])], i18n: st.i18n };
  for (const code of codes) {
    if (!project.languages.includes(code)) fail(`${code} is not one of the project's languages (${project.languages.join(', ')}). Add it with lyngo init --languages.`);
    await translateLanguage(code, project);
  }
}

async function translateLanguage(code, project) {
  const folder = catalogFolder(project);
  const primary = project.primary_language || 'en';
  const primaryPath = path.join(folder, primary + '.json');
  const targetPath = path.join(folder, code + '.json');
  const source = parseCatalog(primaryPath);
  if (!source) fail(`${primaryPath} is missing or not valid JSON.`);
  const current = parseCatalog(targetPath) || {};
  const missing = Object.keys(source).filter((k) => !(k in current) || String(current[k]).trim() === '');
  if (!missing.length) { console.log(`${code}: complete, ${Object.keys(source).length} keys.`); return; }
  let translated = 0, memory = 0, flagged = [];
  const warnings = new Set();
  // Each chunk is one job on the server; the returned catalog carries forward.
  for (let i = 0; i < missing.length; i += 100) {
    const r = await callJob('translate', {
      keys: missing.slice(i, i + 100),
      languages: [code],
      catalogs: [{ path: primaryPath, content: readIfFile(primaryPath) }, { path: targetPath, content: readIfFile(targetPath) || '{}' }],
    });
    const out = (r.catalogs || []).find((c) => c.path === targetPath || c.path.endsWith('/' + code + '.json'));
    if (!out) fail(`the server returned no catalog for ${code}.`);
    fs.mkdirSync(path.dirname(targetPath), { recursive: true });
    fs.writeFileSync(targetPath, out.content);
    const l = (r.report && r.report.languages && r.report.languages[code]) || {};
    translated += l.translated || 0; memory += l.from_memory || 0; flagged.push(...(l.flagged || []));
    for (const w of (r.report && r.report.warnings) || []) warnings.add(String(w));
    if (process.stdout.isTTY) process.stdout.write(`\r${code}: ${Math.min(i + 100, missing.length)}/${missing.length}`);
  }
  const flaggedText = flagged.length ? `; ${flagged.length} flagged for review` : '';
  console.log(`${process.stdout.isTTY ? '\r' : ''}${code}: ${translated} translated, ${memory} from memory${flaggedText} -> ${targetPath}`);
  for (const line of flaggedLines(flagged)) console.log(line);
  for (const line of warningLines(warnings)) console.log(line);
}

// ── onboard: the "copy this into your agent" path ──────────────────────────
// Written for an agent to follow: every run does what it can, reports each
// step to the server under the run id (the page at /start/<id> shows them),
// and stops with one clear instruction whenever a person must act. The same
// command, run again, continues from where it stopped.
const RUN_DIR = path.join(TOKEN_DIR, 'runs');
function runState(id) { try { return JSON.parse(fs.readFileSync(path.join(RUN_DIR, id + '.json'), 'utf8')); } catch { return {}; } }
function saveRunState(id, state) { fs.mkdirSync(RUN_DIR, { recursive: true, mode: 0o700 }); fs.writeFileSync(path.join(RUN_DIR, id + '.json'), JSON.stringify(state), { mode: 0o600 }); }

async function onboard(opts) {
  const id = String(opts.run || '').trim();
  if (!/^[0-9a-f-]{20,}$/i.test(id)) fail('usage: lyngo onboard --run=<id>  (the id comes from lyngo.app/start)');
  const again = `lyngo onboard --run=${id}`;
  const state = runState(id);
  let projectId = state.project_id || null;
  const report = async (step, st, detail) => {
    const body = { step, state: st, detail: detail ? String(detail).slice(0, 480) : undefined, project_id: projectId || undefined };
    try { body.repo = repoRemote() || undefined; } catch {}
    try { await api('POST', `/cli/runs/${id}/step`, { auth: !!readToken(false), body }); } catch {}
  };
  const stop = (lines) => {
    console.log('\nWAITING FOR THE PERSON');
    for (const l of lines) console.log('  ' + l);
    console.log(`  Then run: ${again}`);
  };
  const step = (n, text) => console.log(`\n[${n}/7] ${text}`);

  // 1. The repository: git, a GitHub remote, and Laravel.
  step(1, 'Checking the repository');
  let top;
  try { top = root(); } catch { await report('cli', 'failed', 'not a git repository'); fail('this folder is not a git repository. Ask the person for the root of their Laravel project, then run this command there.'); }
  process.chdir(top);
  const remote = repoRemote();
  if (!remote) { await report('cli', 'failed', 'no origin remote'); fail('this repository has no origin remote on GitHub. Ask the person to push it to GitHub first, then run this command again.'); }
  const composer = readIfFile('composer.json') || '';
  if (!/"laravel\/framework"/.test(composer)) { await report('cli', 'failed', 'not a Laravel application'); fail('this is not a Laravel application (no laravel/framework in composer.json). Lyngo is for Laravel for now. Ask the person which folder holds their Laravel app.'); }
  await report('cli', 'done', `${path.basename(top)} on ${remote}`);
  console.log(`  ${path.basename(top)}: Laravel, remote ${remote}`);

  // 2. Login: a saved token, a pending code, or a new code.
  step(2, 'Logging in');
  let me = null;
  if (readToken(false)) {
    const r = await api('GET', '/cli/me');
    if (r.status === 200) me = r.data.user || r.data;
  }
  if (!me) {
    let pending = state.device;
    if (pending && pending.expires_at > Date.now()) {
      for (let i = 0; i < 3 && !me; i++) {
        const r = await api('POST', '/cli/token', { auth: false, body: { device_code: pending.device_code } });
        if (r.status === 200 && r.data.token) { saveToken(r.data.token); me = r.data.user || {}; break; }
        if (r.data.error === 'authorization_pending' || r.data.error === 'slow_down') { await sleep(3); continue; }
        pending = null; break;
      }
    } else pending = null;
    if (!me) {
      if (!pending) {
        const d = expect(await api('POST', '/cli/device', { auth: false, body: { hostname: os.hostname() } }), 200);
        if (!d || !d.user_code || !d.device_code) fail('the server did not answer with a login code. Check LYNGO_HOST.');
        pending = { device_code: d.device_code, user_code: d.user_code, url: d.verification_url_complete || d.verification_url, expires_at: Date.now() + (Number(d.expires_in) > 0 ? Number(d.expires_in) : 900) * TICK };
        saveRunState(id, { ...state, device: pending });
      }
      await report('login', 'waiting', `Enter ${pending.user_code} at ${pending.url}`);
      stop([`Ask the person to open ${pending.url} and enter the code ${pending.user_code}, then confirm.`, 'They need a Lyngo account (lyngo.app); the page lets them sign up first.']);
      return;
    }
  }
  saveRunState(id, { ...state, device: null, project_id: projectId });
  await report('login', 'done', me.email || me.name || 'signed in');
  console.log(`  Logged in as ${me.email || me.name || 'you'}.`);

  // 3. GitHub and the project.
  step(3, 'Connecting the repository');
  const head = (gitTry(['rev-parse', '--abbrev-ref', 'HEAD']) || '').trim();
  const branch = head && head !== 'HEAD' ? head : undefined;
  const r = await api('POST', '/cli/projects', { body: { remote, branch, workspace: opts.workspace } });
  let project = null;
  if ((r.status === 200 || r.status === 201) && r.data.project) project = r.data.project;
  else if (r.data.status === 'needs_github_app' || r.status === 409) {
    await report('github', 'waiting', r.data.owner ? 'the GitHub App must cover the repository' : 'the workspace owner must connect GitHub');
    const lines = r.data.owner
      ? [`Ask the person to install the Lyngo GitHub app on this repository: ${r.data.connect_url}`, 'On GitHub: the Lyngo app, Configure, Repository access, add the repository.']
      : [`Ask the person to have the workspace owner connect GitHub for this repository at ${r.data.connect_url || HOST + '/source-control'}.`];
    stop(lines);
    return;
  } else { await report('github', 'failed', messageOf(r.data, r.status)); printProblem(r); fail('the project could not be created. The message above says why.'); }
  projectId = project.id;
  saveRunState(id, { ...state, device: null, project_id: projectId });
  await report('github', 'done', project.full_name || project.name);
  console.log(`  ${r.data.status === 'created' ? 'Created' : 'Found'} ${project.name}.`);

  // 4. Detection and languages.
  step(4, 'Detecting the i18n setup');
  await report('setup', 'running', 'detecting');
  const detected = expect(await api('POST', `/cli/projects/${project.id}/detect`, { body: {} }), 200);
  console.log(`  Detected: ${detected.summary || 'no i18n setup found'}`);
  if (detected.i18n) project = { ...project, i18n: detected.i18n };
  const primary = opts.primary || project.primary_language || 'en';
  let targets = (project.languages || []).filter((l) => l !== primary);
  if (opts.languages) {
    const list = [primary, ...opts.languages.filter((l) => l !== primary)];
    const u = await api('PATCH', `/cli/projects/${project.id}`, { body: { languages: list, primary_language: primary } });
    if (u.status !== 200) { printProblem(u); await report('languages', 'failed', messageOf(u.data, u.status)); fail('the languages were not saved. The message above says why.'); }
    project = { ...project, ...(u.data.project || {}) };
    targets = (project.languages || list).filter((l) => l !== primary);
  }
  if (!targets.length) {
    await report('languages', 'waiting', 'which languages to translate into');
    stop([`Ask the person which languages to translate into (codes such as fr, de, ar, ja), source ${primary}.`, `Then run: ${again} --languages fr,de`]);
    return;
  }
  await report('languages', 'done', `${primary} -> ${targets.join(', ')}`);
  console.log(`  Languages: ${primary} -> ${targets.join(', ')}`);

  // 5. Setup as a patch, 6. the hook, missing catalogs.
  step(5, 'Applying the i18n setup');
  await scaffold(project, opts);
  await report('setup', 'done', detected.summary || 'ready');
  step(6, 'Wiring the agent');
  setUpClaudeCode(top, remote);
  await report('hook', 'done', findOnPath('claude') ? 'Stop hook and MCP server registered' : 'no Claude Code here; run lyngo localize before committing');
  await fillMissingCatalogs(project, { yes: true });

  // 7. The first localized change.
  step(7, 'Localizing a first change');
  const changed = changedFiles(top);
  if (!changed.length) {
    await report('localize', 'waiting', 'make one change, then run again');
    stop(['Make one change a person can see: add a sentence of plain text to a view or a page component (no i18n call, the CLI adds it).', 'You may do this yourself: pick a page under resources/, add one paragraph of English text.']);
    return;
  }
  const result = await localize({});
  const summary = result ? `${result.wrapped} strings localized in ${result.files} files; ${result.added} new keys, ${result.reused} reused; ${result.languages} languages filled` : 'nothing to localize in the changed files';
  await report('localize', 'done', summary);
  console.log(`\nDONE. ${summary}.`);
  console.log('Show the person `git diff`, and tell them: build as usual; lyngo localize runs when the agent finishes a task, or by hand before a commit.');
}

// ── localize, check, status ────────────────────────────────────────────────

function changedFiles(top) {
  const out = new Set();
  // The working tree's own changes, then each checked-out submodule's.
  for (const sub of ['', ...submodules()]) {
    const status = sub ? gitTry(['-C', sub, 'status', '--porcelain', '--untracked-files=all']) : git(['status', '--porcelain', '--untracked-files=all']);
    for (const l of (status || '').split('\n').filter(Boolean)) {
      const p = l.slice(3).trim().replace(/^"|"$/g, '');
      const rel = (sub ? sub + '/' : '') + (p.includes(' -> ') ? p.split(' -> ')[1] : p);
      if (SRC.test(rel) && !SKIP.test(rel) && fs.existsSync(path.join(top, rel))) out.add(rel);
    }
  }
  return [...out].sort();
}

// Every tracked source file of the repository, as the scan would pick them:
// a quick local cut by extension and folder, then the server's own rules.
async function allSourceFiles(top) {
  // The files of checked-out submodules too (packages/ui of lyngo-gaps): the app renders them.
  const tracked = git(['ls-files', '-z', '--recurse-submodules']).split('\0').filter(Boolean).filter((p) => SRC.test(p) && !SKIP.test(p) && fs.existsSync(path.join(top, p)));
  if (tracked.length === 0) return [];
  try {
    const r = await call('select_files', { paths: tracked });
    if (Array.isArray(r.paths)) return r.paths.filter((p) => tracked.includes(p));
  } catch { /* an older server without the tool: the local cut stands */ }
  return tracked;
}

function sha1(p) { try { return crypto.createHash('sha1').update(fs.readFileSync(p)).digest('hex'); } catch { return null; } }
// The SHA git names a file's content by (git hash-object).
function gitBlob(content) {
  const bytes = Buffer.isBuffer(content) ? content : Buffer.from(String(content), 'utf8');
  return crypto.createHash('sha1').update(`blob ${bytes.length}\0`).update(bytes).digest('hex');
}

// The paths a localize answer listed in "needs", read from the repository as
// {path, content}: only source files (SRC, not SKIP, never .env or keys),
// relative paths that stay inside it (no symlink out),
// regular files of at most 512 KB, not already in the batch, 50 at most (the
// server's limits). A missing or unreadable one is left out, and so is one that is not UTF-8 (named in notUtf8).
// "needs_sha" names the blob the server read a path at (a file a cross-file
// decision read, 0.2.18): a copy with that blob is what the server read, so it
// is left out. The copy is the one an earlier batch sent (before its patch), else the disk's.
const CONTEXT_MAX_FILES = 50;
const CONTEXT_MAX_BYTES = 512 * 1024;
function contextFiles(top, needs, payload, notUtf8, needsSha = {}, sentBlobs = new Map()) {
  if (!Array.isArray(needs)) return [];
  const sent = new Set(payload.map((f) => f.path));
  const readAt = needsSha && typeof needsSha === 'object' ? needsSha : {};
  let realTop;
  try { realTop = fs.realpathSync(top); } catch { return []; }
  const out = [];
  for (const p of new Set(needs)) {
    if (out.length >= CONTEXT_MAX_FILES) break;
    if (typeof p !== 'string' || p === '' || sent.has(p) || p.includes('\0') || path.isAbsolute(p) || /^[A-Za-z]:/.test(p) || !SRC.test(p) || SKIP.test(p) || p.split(/[\\/]/).includes('..')) continue;
    try {
      const full = fs.realpathSync(path.join(realTop, p));
      if (!full.startsWith(realTop + path.sep)) continue;
      const st = fs.statSync(full);
      if (!st.isFile() || st.size > CONTEXT_MAX_BYTES) continue;
      const bytes = fs.readFileSync(full);
      if (typeof readAt[p] === 'string' && (sentBlobs.get(p) || gitBlob(bytes)) === readAt[p]) continue;
      const content = utf8(bytes);
      if (content === null) { if (notUtf8) notUtf8.add(p); continue; }
      out.push({ path: p, content });
    } catch { /* missing or unreadable: left out */ }
  }
  return out;
}

// The paths a unified diff changes (its "+++ b/<path>" lines; a deleted file has none).
function patchPaths(patch) {
  return [...String(patch).matchAll(/^\+\+\+ b\/(.+?)\t?$/gm)].map((m) => m[1]);
}

// git apply is all or nothing: one block that does not apply (a file the server
// read differently) dropped the 8 good files of its batch with it (lyngo-gaps,
// 2026-11-11). When the whole patch fails, each file's "diff --git" block goes
// alone. Returns the paths applied and, for the rest, git's reason.
function gitApply(text) {
  const tmp = path.join(os.tmpdir(), `lyngo-${process.pid}-${Date.now()}-${crypto.randomBytes(4).toString('hex')}.patch`);
  fs.writeFileSync(tmp, text);
  try { git(['apply', '--whitespace=nowarn', tmp]); return null; }
  catch (e) { return String(e.stderr || e.message || 'git apply failed').trim().split('\n').map((l) => l.replace(/^error: /, '').trim()).filter(Boolean).join('; '); }
  finally { try { fs.unlinkSync(tmp); } catch { /* already gone */ } }
}
function blockPath(block) {
  const m = block.match(/^\+\+\+ b\/(.+?)\t?$/m) || block.match(/^--- a\/(.+?)\t?$/m) || block.match(/^diff --git a\/(.+?) b\//);
  return m ? m[1] : '(unknown file)';
}
function applyPatch(patch) {
  const whole = gitApply(patch);
  if (whole === null) return { applied: patchPaths(patch), failed: [], split: false };
  const blocks = String(patch).split(/^(?=diff --git )/m).filter((b) => b.startsWith('diff --git '));
  if (blocks.length === 0) return { applied: [], failed: [{ path: '(the patch)', reason: whole, block: patch }], split: false };
  const applied = [];
  const failed = [];
  for (const b of blocks) {
    const block = b.endsWith('\n') ? b : b + '\n';
    const reason = gitApply(block);
    if (reason === null) applied.push(blockPath(block)); else failed.push({ path: blockPath(block), reason, block });
  }
  return { applied, failed, split: true };
}

// The parts of report.enum_labels.counts that are edits, with their words; the
// rest (enums_read, left...) are not changes. An older server sends no counts.
const ENUM_PARTS = [['enums_added', 'enum', 'enums'], ['resource', 'resource', 'resources'], ['prop', 'prop', 'props'], ['text', 'sentence', 'sentences'], ['blade', 'view', 'views'], ['livewire', 'Livewire view', 'Livewire views'], ['table', 'table column', 'table columns'], ['components', 'frontend read', 'frontend reads'], ['types', 'type', 'types'], ['filament', 'Filament label', 'Filament labels']];
function enumLabelParts(counts) {
  return ENUM_PARTS.filter(([k]) => counts[k] > 0).map(([k, one, many]) => `${counts[k]} ${counts[k] === 1 ? one : many}`);
}

// The files a frontend build bundles, and the package manager the lockfile at the top names (npm when none).
const FRONTEND_FILE = /\.(?:jsx?|tsx?|vue|svelte)$/;
const LOCKFILES = [['pnpm-lock.yaml', 'pnpm'], ['yarn.lock', 'yarn'], ['bun.lock', 'bun'], ['bun.lockb', 'bun']];
const packageManager = () => (LOCKFILES.find(([f]) => fs.existsSync(f)) || [null, 'npm'])[1];

async function localize(opts) {
  const top = root();
  process.chdir(top);
  // In hook mode the report goes to the agent, not the terminal (localizeHook).
  const lines = [];
  const say = (line) => (opts.hook ? lines.push(line) : console.log(line));
  // --all: the whole repository, not the changed files. The server picks the
  // paths a scan would process out of the tracked tree (its own rules, so
  // the two never drift); the server's batches do the rest (2026-10-18).
  let files = opts.all ? await allSourceFiles(top) : changedFiles(top);
  // The hook runs at every stop: it sends only the files whose content changed
  // since its last successful run, so a stop without new edits costs nothing.
  const changed = files;
  const statePath = opts.hook ? path.resolve(top, git(['rev-parse', '--git-path', 'lyngo-hook.json']).trim()) : null;
  if (statePath) { const seen = parseCatalog(statePath) || {}; files = files.filter((p) => seen[p] !== sha1(p)); }
  // A file in Windows-1252 becomes UTF-8 on disk first (not with --dry, which changes nothing).
  // One that is not UTF-8 after that is never sent (readIfFile): it is named and left as written.
  // The hook state records it, so the next stop does not name it again.
  const converted = opts.dry ? [] : files.filter((p) => convertToUtf8(p));
  const notUtf8 = new Set();
  files = files.filter((p) => readIfFile(p, notUtf8) !== null);
  // Recorded after the patch, so the hook's own changes never count as new edits;
  // a file whose block did not apply is left out, so the next stop sends it again.
  const failedPaths = new Set();
  const saveHookState = () => { if (statePath) fs.writeFileSync(statePath, JSON.stringify(Object.fromEntries(changed.filter((p) => !failedPaths.has(p)).map((p) => [p, sha1(p)]))) + '\n'); };
  if (files.length === 0) {
    if (!notUtf8.size) { say(opts.all ? 'lyngo: no source file of this project found in the repository.' : 'lyngo: nothing changed in the working tree.'); return null; }
    say(`lyngo: nothing sent; ${notUtf8.size} file${notUtf8.size === 1 ? ' is' : 's are'} not UTF-8.`);
    for (const p of notUtf8) say(notUtf8Line(p));
    for (const p of converted) say(convertedLine(p));
    saveHookState();
    return { wrapped: 0, files: 0, added: 0, reused: 0, languages: 0, byLanguage: {}, sent: 0, patched: false, lines, changedFiles: 0, changedCatalogs: 0, moreFiles: 0, enumLabels: false, notUtf8: [...notUtf8], failed: [] };
  }
  const status = await call('status', {});
  const langs = opts.languages || [status.primary_language, ...(status.languages || [])];
  // Both catalog folders (Laravel's lang and the frontend's own), read again
  // before EVERY call: a catalog the previous batch created must go back, or
  // the server diffs it as new twice (corp1, 2026-10-18: "already exists").
  const folders = [...new Set([status.i18n?.catalog_folder || 'lang', status.i18n?.js_catalog_folder].filter(Boolean).map((f) => f.replace(/\/+$/, '')))];
  // Laravel's own lang/<code>/*.php go too: the server builds the PHP keys on
  // them and diffs against them, or a second run writes them again as new
  // files and the patch fails with "already exists".
  const phpFolder = (status.i18n?.catalog_folder || 'lang').replace(/\/+$/, '');
  const catalogsNow = () => {
    const out = [];
    for (const folder of folders) for (const code of langs) {
      const p = path.join(folder, code + '.json');
      const c = readIfFile(p, notUtf8);
      if (c !== null) out.push({ path: p, content: c });
    }
    for (const code of langs) {
      const dir = path.join(phpFolder, code);
      let names = [];
      try { names = fs.readdirSync(dir).filter((n) => n.endsWith('.php')).sort(); } catch { /* no PHP lang files for this language */ }
      for (const n of names) { const c = readIfFile(path.join(dir, n), notUtf8); if (c !== null) out.push({ path: path.join(dir, n), content: c }); }
    }
    return out;
  };
  const total = files.length;
  if (opts.all) say(`lyngo: localizing ${total} file${total === 1 ? '' : 's'} in batches; each batch applies before the next.`);
  // Progress while a job runs goes to the terminal; the hook keeps its output to the report.
  const progress = opts.hook ? null : (line) => console.log(line);
  const report = { files: [], added: [], reused: [], languages: {}, missing: new Set(), skipped: [], untranslated: {}, notes: [], warnings: new Set(), laravelLang: [] };
  let batch = 0;
  let patched = false;
  let gotPatch = false; // a patch came back (applied, or printed by --dry)
  const changedPaths = new Set();
  const failed = []; // {path, reason, block} of each file whose block did not apply
  const enumCounts = {};
  const sentBlobs = new Map(); // path => blob of the content last sent: a batch's files before its patch
  while (files.length) {
    batch++;
    const payload = [];
    for (const p of files) { const c = readIfFile(p, notUtf8); if (c !== null) { payload.push({ path: p, content: c }); sentBlobs.set(p, gitBlob(c)); } }
    if (payload.length === 0) break;
    const args = { files: payload, catalogs: catalogsNow(), format: 'patch' };
    if (opts.languages) args.languages = opts.languages.filter((l) => l !== status.primary_language);
    // --no-translate: keys only, catalogs for translators. Without the flag the project's setting decides.
    if (opts['no-translate']) args.translate = false;
    let r = await callJob('localize', args, progress);
    // "needs": files this batch reads that the server took from GitHub, where
    // the working tree may be ahead (an enum an unpushed run gave getLabel(),
    // vito 2026-11-08). That answer is not applied: the batch goes once more
    // with those files from disk as read-only context. Older servers never send it.
    // A file whose blob is the one the server read (needs_sha) is left out; none left, the answer applies.
    const context = contextFiles(top, r.needs, payload, notUtf8, r.needs_sha, sentBlobs);
    if (context.length) {
      if (progress) progress(`  ... sending ${context.length} file${context.length === 1 ? '' : 's'} the server reads from this working tree, and the batch again`);
      r = await callJob('localize', { ...args, context }, progress);
    }
    if (r.patch && r.patch.trim()) {
      gotPatch = true;
      if (opts.dry) { process.stdout.write(r.patch); for (const p of patchPaths(r.patch)) changedPaths.add(p); }
      else {
        const a = applyPatch(r.patch);
        for (const p of a.applied) changedPaths.add(p);
        if (a.applied.length) patched = true;
        if (a.split || a.failed.length) {
          say(`  ${opts.all ? `batch ${batch}: ` : ''}the patch did not apply as a whole; each file alone:`);
          for (const p of a.applied) say(`    applied: ${p}`);
          for (const f of a.failed) say(`    failed: ${f.path} (${f.reason})`);
        }
        for (const f of a.failed) { failed.push(f); failedPaths.add(f.path); }
      }
    }
    for (const f of r.report?.files || []) if (f.wrapped?.length) report.files.push(f);
    for (const k of r.report?.dot_keys || []) report.missing.add(k);
    report.added.push(...(r.report?.primary?.added || []));
    report.reused.push(...(r.report?.primary?.already_there || []));
    for (const [code, l] of Object.entries(r.report?.languages || {})) {
      const cur = report.languages[code] || { translated: 0, from_memory: 0, flagged: [] };
      cur.translated += l.translated || 0; cur.from_memory += l.from_memory || 0; cur.flagged.push(...(l.flagged || []));
      report.languages[code] = cur;
      if (l.untranslated?.length) (report.untranslated[code] = report.untranslated[code] || []).push(...l.untranslated);
    }
    report.skipped.push(...(r.report?.skipped || []));
    report.laravelLang.push(...(r.report?.laravel_lang || []));
    for (const w of r.report?.warnings || []) report.warnings.add(String(w));
    for (const [k, v] of Object.entries(r.report?.enum_labels?.counts || {})) if (typeof v === 'number') enumCounts[k] = (enumCounts[k] || 0) + v;
    // What the server says beyond the steps this CLI takes itself (apply, call again).
    const note = String(r.next || '').replace(/Apply the patch, then call again with the files in "deferred"\.|Apply the patch with git apply, then show the user the report\./g, '').trim();
    if (note && !report.notes.includes(note)) report.notes.push(note);
    files = r.deferred || [];
    if (opts.all) {
      const done = total - files.length;
      const got = (r.report?.files || []).reduce((n, f) => n + (f.wrapped?.length || 0), 0);
      say(`  batch ${batch}: ${done}/${total} files, ${got} string${got === 1 ? '' : 's'} localized`);
    }
  }
  saveHookState();
  // A file whose block did not apply localized nothing.
  report.files = report.files.filter((f) => !failedPaths.has(f.path));
  const wrapped = report.files.reduce((n, f) => n + f.wrapped.length, 0);
  say(`lyngo: ${wrapped} string${wrapped === 1 ? '' : 's'} localized in ${report.files.length} file${report.files.length === 1 ? '' : 's'}; ${report.added.length} new key${report.added.length === 1 ? '' : 's'}, ${report.reused.length} reused.${serverSeen ? ` (server ${serverSeen})` : ''}`);
  for (const f of report.files) say(`  ${f.path}: ${f.wrapped.slice(0, 6).map((s) => JSON.stringify(s)).join(', ')}${f.wrapped.length > 6 ? ', …' : ''}`);
  // Every file the patch changed, the enum-label edits too (they wrap no string); the catalogs apart.
  const isCatalog = (p) => folders.some((f) => p.startsWith(f + '/'));
  const editedFiles = [...changedPaths].filter((p) => !isCatalog(p));
  const editedCatalogs = changedPaths.size - editedFiles.length;
  const changedLine = [editedFiles.length ? `files changed: ${editedFiles.length}` : '', editedCatalogs ? `catalogs changed: ${editedCatalogs}` : ''].filter(Boolean).join(', ');
  if (changedLine) say(`  ${changedLine}`);
  const enumParts = enumLabelParts(enumCounts);
  if (enumParts.length) say(`  enum labels: ${enumParts.join(', ')}`);
  if (opts['no-translate'] || (status.translate_on_localize === false && !Object.keys(report.languages).length)) say('  catalogs: not translated (keys only).');
  for (const [code, l] of Object.entries(report.languages)) {
    const flagged = l.flagged.length ? `; ${l.flagged.length} flagged for review` : '';
    say(`  ${code}: ${l.translated} translated, ${l.from_memory} from memory${flagged}`);
    for (const line of flaggedLines(l.flagged)) say(line);
  }
  if (report.missing.size) say(`  path keys no catalog holds: ${[...report.missing].slice(0, 6).map((k) => JSON.stringify(k)).join(', ')}${report.missing.size > 6 ? ', …' : ''}`);
  for (const [code, keys] of Object.entries(report.untranslated)) say(`  ${code}: ${keys.length} key${keys.length === 1 ? '' : 's'} not translated yet (${keys.slice(0, 3).map((k) => JSON.stringify(k)).join(', ')}${keys.length > 3 ? ', …' : ''}): run lyngo translate ${code}`);
  for (const sk of report.skipped) say(`  skipped ${sk.path}: ${sk.reason}`);
  for (const note of report.notes) say(`  ${note}`);
  if (!gotPatch) say('  Nothing to change: every string a person reads already goes through an i18n call.');
  // Vite serves the old bundle until the assets are built again, after the summary and before the warnings (not with --dry, which changes nothing).
  if (!opts.dry && editedFiles.some((p) => FRONTEND_FILE.test(p))) say(`Rebuild your assets to see the changes: ${packageManager()} run build (or ${packageManager()} run dev).`);
  for (const line of warningLines(report.warnings)) say(line);
  for (const p of notUtf8) say(notUtf8Line(p));
  for (const p of converted) say(convertedLine(p));
  const laravelLang = [...new Set(report.laravelLang)];
  if (laravelLang.length) say(`  Laravel lang files added: ${laravelLang.slice(0, 6).join(', ')}${laravelLang.length > 6 ? `, and ${laravelLang.length - 6} more` : ''}`);
  const subs = submodules();
  for (const sub of [...new Set([...changedPaths].map((p) => submoduleOf(p, subs)).filter(Boolean))].sort()) say(`  ${sub} is a submodule: commit it there too`);
  if (failed.length) {
    // The blocks that did not apply stay on disk for a look; the run exits 1 (the hook always exits 0).
    const kept = path.join(os.tmpdir(), `lyngo-failed-${Date.now()}.patch`);
    fs.writeFileSync(kept, failed.map((f) => f.block).join(''));
    say(`lyngo: ${failed.length} file${failed.length === 1 ? '' : 's'} not changed, the patch did not apply: ${failed.map((f) => f.path).join(', ')}. The blocks are at ${kept}`);
    if (!opts.hook) process.exitCode = 1;
  }
  const wrappedPaths = new Set(report.files.map((f) => f.path));
  return { wrapped, files: report.files.length, added: report.added.length, reused: report.reused.length, languages: Object.keys(report.languages).length, byLanguage: report.languages, sent: total, patched, lines, changedFiles: editedFiles.length, changedCatalogs: editedCatalogs, moreFiles: editedFiles.filter((p) => !wrappedPaths.has(p)).length, enumLabels: enumParts.length > 0, notUtf8: [...notUtf8], failed: failed.map((f) => f.path) };
}

// ── the Claude Code Stop hook ──────────────────────────────────────────────
// A Stop hook's plain stdout reaches only Claude Code's debug log. It reads one
// JSON object instead: systemMessage is a line for the person, and
// additionalContext wakes the agent with the report. Always exit 0: exit 2 or
// a "block" decision shows as an error, any other code as a hook error.
const HOOK_CLIP = 7000; // each field is capped at 10,000 characters, and JSON escaping adds some
const clip = (s, n) => (s.length > n ? s.slice(0, n - 1) + '…' : s);
function hookOut(systemMessage, context) {
  // The update line goes with the report, never alone: it does not wake the agent by itself.
  const notice = updateNotice();
  const out = { systemMessage: notice ? `${clip(systemMessage, 300)}. ${notice}` : clip(systemMessage, 500) };
  if (context && notice) context += `\n\n${notice}. Tell the user in one sentence that a newer Lyngo CLI is available, with that command.`;
  if (context) out.hookSpecificOutput = { hookEventName: 'Stop', additionalContext: context };
  process.stdout.write(JSON.stringify(out) + '\n');
}

async function localizeHook(opts) {
  quiet = true;
  let input = {};
  if (!process.stdin.isTTY) {
    let raw = '';
    try { for await (const chunk of process.stdin) raw += chunk; input = JSON.parse(raw); } catch { /* no input: run as a plain stop */ }
  }
  // Claude is already continuing because of a stop hook: a second report would loop.
  if (input && input.stop_hook_active === true) return;
  // Claude Code runs the hook in the session's current directory, which can be
  // another repository (a live ~/.nvm): the project is where the session started.
  // Not stdin's cwd, that is the same current directory.
  const projectDir = process.env.CLAUDE_PROJECT_DIR;
  if (projectDir) {
    try {
      if (fs.statSync(projectDir).isDirectory() && execFileSync('git', ['rev-parse', '--is-inside-work-tree'], { cwd: projectDir, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim() === 'true') process.chdir(projectDir);
    } catch { /* not a directory in a git work tree: the current directory stands */ }
  }
  let r;
  try {
    r = await localize(opts);
  } catch (e) {
    const t = (() => { try { return readToken(false); } catch { return null; } })();
    const msg = scrub((e && e.message) || String(e), t).replace(/\s+/g, ' ').trim().replace(/\.$/, '');
    const fix = e instanceof CliTooOld ? `update the CLI with ${UPDATE_COMMAND}, then run /lyngo:localize`
      : /\blogin\b/i.test(msg) ? 'run /lyngo:login (or lyngo login in a terminal)'
      : /lyngo init/i.test(msg) ? 'run /lyngo:init (or lyngo init in a terminal)'
      : 'run /lyngo:localize to try again';
    hookOut('Lyngo: ' + msg, `Lyngo could not localize the changes: ${clip(msg, HOOK_CLIP)}. Tell the user, with the fix: ${fix}.`);
    return;
  }
  if (!r) return;
  const n = (count, word) => `${count} ${word}${count === 1 ? '' : 's'}`;
  // Files Lyngo did not change: a block that did not apply, or a file that is not UTF-8.
  const problems = [r.failed.length ? `${n(r.failed.length, 'file')} not changed (the patch did not apply)` : '', r.notUtf8.length ? `${n(r.notUtf8.length, 'file')} left as written (not UTF-8)` : ''].filter(Boolean).join('; ');
  const tellProblems = problems ? ' Tell the user which files Lyngo did not change and why.' : '';
  if (!r.patched) {
    const checked = r.sent ? `checked ${n(r.sent, 'file')}, nothing to localize` : '';
    if (!problems) { hookOut(`Lyngo: ${checked}`); return; }
    hookOut(`Lyngo: ${[checked, problems].filter(Boolean).join('; ')}`, clip(r.lines.join('\n'), HOOK_CLIP) + '\n\nLyngo changed no file.' + tellProblems);
    return;
  }
  const langs = Object.entries(r.byLanguage)
    .filter(([, l]) => l.translated || l.from_memory || l.flagged.length)
    .map(([code, l]) => `${code}: ${l.translated} translated${l.from_memory ? `, ${l.from_memory} from memory` : ''}${l.flagged.length ? `, ${l.flagged.length} flagged for review` : ''}`);
  const enumMark = r.enumLabels ? ' (enum labels)' : '';
  // No string wrapped, but the patch changed files (enum labels): say what changed.
  const what = [r.changedFiles ? n(r.changedFiles, 'file') : '', r.changedCatalogs ? n(r.changedCatalogs, 'catalog') : ''].filter(Boolean).join(' and ') || 'files';
  const head = r.wrapped
    ? `${n(r.wrapped, 'string')} localized in ${n(r.files, 'file')}, ${n(r.added, 'new key')}${r.reused ? `, ${r.reused} reused` : ''}${r.moreFiles ? `, ${r.moreFiles} more ${r.moreFiles === 1 ? 'file' : 'files'} changed${enumMark}` : ''}`
    : `${what} changed${enumMark}${r.added ? `, ${n(r.added, 'new key')}` : ''}`;
  hookOut(
    `Lyngo: ${head}${langs.length ? '; ' + langs.join('; ') : ''}${problems ? '; ' + problems : ''}`,
    clip(r.lines.join('\n'), HOOK_CLIP) + '\n\nLyngo has already updated these files and the catalogs on disk. Tell the user in one or two sentences what Lyngo changed. Do not edit those files or the catalogs again. If the user checks the page, rebuild the frontend first.' + tellProblems,
  );
}

async function check(file) {
  if (!file) fail('usage: lyngo check <file>');
  const content = utf8(fs.readFileSync(file));
  if (content === null) fail(`${file} is not UTF-8; it is not sent, and left as written.`);
  const r = await call('check', { path: file, content });
  // On a path-key project each string has its own key; else the text is the key.
  const lines = r.key_style === 'path'
    ? Object.entries(r.keys || {}).map(([k, text]) => `${k} => ${JSON.stringify(text)}`)
    : (r.user_facing_strings || []).map((text) => JSON.stringify(text));
  const count = r.count ?? lines.length;
  console.log(`${file}: ${count} user-facing string${count === 1 ? '' : 's'}`);
  for (const line of lines.slice(0, 30)) console.log('  ' + line);
  if (r.changed === false && r.note) console.log(r.note);
}

async function status() {
  const r = await call('status', {});
  console.log(`${r.project}: ${r.i18n?.framework} / ${r.i18n?.library} / ${r.i18n?.function}(), catalogs in ${r.i18n?.catalog_folder}`);
  console.log(`languages: ${r.primary_language} -> ${(r.languages || []).join(', ')}`);
  if (r.refused_strings?.length) console.log(`refused (never localize): ${r.refused_strings.slice(0, 8).map((s) => JSON.stringify(s)).join(', ')}`);
  if (serverSeen) console.log(`server: ${serverSeen}`);
}

// ── entry ──────────────────────────────────────────────────────────────────

const HELP = `lyngo ${VERSION}: localization for your repository, from the terminal.

  lyngo login                       sign in once (opens the browser)
  lyngo logout                      revoke the token and delete it from this machine
  lyngo whoami                      who the token belongs to
  lyngo init [--languages fr,de] [--primary en] [--workspace <name>] [--yes] [--github] [--wait] [--no-wait] [--no-install]
                                    connect this repository: project, i18n setup, languages, agent hook
                                    (--languages are the target languages; the source stays en unless --primary)
                                    (it waits for the GitHub App: 10 minutes in a terminal, 9 without one)
                                    (--no-wait: stop with exit code 3 instead of waiting; the default when CI is set)
                                    (--no-install: print the package install command instead of running it)
  lyngo onboard --run=<id> [--languages fr,de]
                                    the guided setup an agent follows, from lyngo.app/start; run it again to continue
  lyngo localize [--all] [--languages fr,de] [--no-translate] [--dry] [--hook]
                                    localize what changed in the working tree, and translate it
                                    (--no-translate: keys only; the project setting "Translate when localizing" is the default)
                                    (--all: the whole repository instead of the changed files, in batches of 30)
                                    (--hook: the Claude Code Stop hook; one JSON object, only files changed since its last run)
  lyngo translate <code> [<code>…]  fill every key a language's catalog lacks, from the primary catalog
  lyngo check <file>                the user-facing strings of one file
  lyngo status                      the project as Lyngo knows it

Config: LYNGO_HOST (default https://lyngo.app), LYNGO_TOKEN or ~/.config/lyngo/token.`;

// On stderr, so stdout stays the command's own output (a --dry patch). The hook prints it in its JSON.
function printUpdateNotice() {
  if (quiet) return;
  const notice = updateNotice();
  if (notice) console.error(notice);
}

function parse(argv) {
  const opts = { _: [] };
  const valued = new Set(['languages', 'workspace', 'primary', 'run']);
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '-y') { opts.yes = true; continue; }
    if (a === '-h') { opts.help = true; continue; }
    if (a === '-v') { opts.version = true; continue; }
    if (!a.startsWith('--')) { opts._.push(a); continue; }
    const [k, inline] = a.slice(2).split(/=(.*)/s);
    if (valued.has(k)) {
      const v = inline !== undefined ? inline : argv[++i];
      if (v === undefined || v.startsWith('--')) fail(`--${k} needs a value.`);
      opts[k] = k === 'languages' ? v.split(',').map((s) => s.trim()).filter(Boolean) : v;
    } else {
      opts[k] = true;
    }
  }
  return opts;
}

(async () => {
  try {
    const [cmd, ...rest] = process.argv.slice(2);
    if (cmd === '--version' || cmd === '-v' || cmd === 'version') { console.log(VERSION); return; }
    if (!cmd || cmd === 'help' || cmd === '--help' || cmd === '-h') { console.log(HELP); return; }
    const opts = parse(rest);
    if (opts.help) { console.log(HELP); return; }
    switch (cmd) {
      case 'login': await login(); break;
      case 'logout': await logout(); break;
      case 'whoami': await whoami(); break;
      case 'init': await init(opts); break;
      case 'localize': await (opts.hook ? localizeHook(opts) : localize(opts)); break;
      case 'onboard': await onboard(opts); break;
      case 'translate': await translate(opts); break;
      case 'check': await check(opts._[0]); break;
      case 'status': await status(); break;
      default: console.error(`lyngo: unknown command "${cmd}".\n\n${HELP}`); process.exitCode = 1;
    }
  } catch (e) {
    const t = (() => { try { return readToken(false); } catch { return null; } })();
    console.error('lyngo: ' + scrub(e instanceof CliError ? e.message : (e && e.message) || String(e), t));
    printUpdateNotice();
    process.exit(1);
  }
  printUpdateNotice();
})();
